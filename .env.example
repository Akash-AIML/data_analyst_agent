# AI Data Analyst Environment Configuration
# Copy this file to .env and fill in your API keys before running the application.

# Primary LLM provider (OpenAI-compatible endpoint).
# OPENAI_BASE_URL may point at the API root (".../v1") OR the full
# ".../v1/chat/completions" URL (e.g. NVIDIA NIM) - the code normalizes both.
# OPENAI_API_BASE is accepted as an alias for the API root.
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_API_BASE="https://integrate.api.nvidia.com/v1"
# MODEL="nvidia/nemotron-mini-4b-instruct"
MODEL="nvidia/nemotron-mini-4b-instruct"

# Fallback providers (optional; used when the primary fails):
GROQ_API_KEY=""
GEMINI_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ----- Optional toggles -----
# Budget hard-cap in USD for the whole pipeline run (0 disables).
LLM_BUDGET_US="1.0"
# Minimum seconds between LLM calls (rate-limit pacing).
LLM_MIN_INTERVAL_S="1.0"
# LLM opt-in for deterministic steps: profiler / planner / reflector.
# Leave unset/default to run fully deterministic (zero LLM spend there).
#LLM_PROFILER="1"
#LLM_PLANNER="1"
#LLM_REFLECTOR="1"
# Respondences; disable the AI self-consistency audit call.
#SET_CONSISTENCY="1"

# ----- LangSmith tracing (optional) -----
# Set LANGSMITH_TRACING_V2=true with an API key to ship every LLM call and
# LangGraph node to https://smith.langchain.com for observability. Tracing is
# fully no-op when unset (no network calls, no latency overhead).
#LANGSMITH_TRACING_V2="true"
#LANGSMITH_API_KEY="lsv2_pt_..."
#LANGSMITH_PROJECT="ai-data-analyst"
# Endpoint override only needed for self-hosted / EU region deployments.
#LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"

# ----- Sandbox executor (POSIX resource limits) -----
# Wall-clock timeout for each generated analysis snippet (seconds).
#EXECUTION_TIMEOUT="30"
# Hard CPU-time cap for the child (defaults to EXECUTION_TIMEOUT).
#EXEC_CPU_LIMIT_S="30"
# Address-space cap in MB (RLIMIT_AS); pandas/matplotlib peaks must fit.
#EXEC_MEM_LIMIT_MB="1536"

# ----- Verify-by-recompute tolerance -----
# Relative tolerance for the insight fact-check gate (default 3%).
# Lower values make the gate stricter; higher values forgive rounding.
#RECOMPUTE_TOLERANCE="0.03"
# Absolute tolerance added on top of the relative tolerance.
#RECOMPUTE_ABS_TOLERANCE="1e-4"

# ----- LLM response cache -----
# Persist deterministic structured-output responses across runs.
#LLM_CACHE_ENABLED="1"
#LLM_CACHE_PATH="output/llm_cache.json"
#LLM_CACHE_CAP="512"
#LLM_CACHE_TTL_S="604800"

# ----- Report Generation -----
# The primary HTML deliverable is the Sweetviz profile report. PDF generation
# is disabled by default; opt in via weasyprint only if you need it (requires
# native system libraries).
#ENABLE_PDF="1"

# ----- API Security & CORS -----
# Secret bearer token to restrict /analyze and /chat endpoints (disabled if empty).
#API_BEARER_TOKEN="your-secret-api-token"
#ALLOWED_ORIGINS="*"